DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=golden_fantastic

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé secrète pour signer les sessions internes (générer avec: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production

# Clé API Duffel (achat de billets d'avion) — utilisez une clé "duffel_test_..."
# pour le développement (aucun paiement/réservation réel). Une clé "duffel_live_..."
# déclenche de vrais achats. Récupérable sur https://app.duffel.com après création de compte.
DUFFEL_API_KEY=

# --- WhatsApp Cloud API + worker (CLAUDE.md §3centquadragies) ---
# Clé maître de chiffrement des secrets stockés en base (jetons Meta...).
# 32 octets : openssl rand -base64 32. ⚠️ La changer rend illisibles les
# secrets déjà enregistrés (à ressaisir dans /admin/whatsapp/parametres).
SECRETS_ENCRYPTION_KEY=
# Redis (file d'attente BullMQ). En local : docker run -d --name golden-fantastic-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379
# Version de la Graph API Meta utilisée.
META_GRAPH_API_VERSION=v23.0
# Optionnel : app secret commun si toutes les agences partagent la même
# application Meta (sinon, saisi par agence dans l'admin).
META_APP_SECRET=
# Optionnel : jeton de vérification global du webhook (sinon, celui de
# chaque compte, généré dans l'admin).
META_WEBHOOK_VERIFY_TOKEN=
# Dossier privé des médias reçus (hors public/).
WA_MEDIA_DIR=storage/wa-media
# 1 = renvoie chaque texte reçu (comptes au statut "test" uniquement) — recette Lot 0.
WA_ECHO_TEST=0

# --- Agent IA Claude (Lot 1, CLAUDE.md §3centunquadragies) ---
# Clé API Anthropic (Claude Console). Sans clé, chaque message WhatsApp est
# transmis directement à un conseiller.
ANTHROPIC_API_KEY=
# Délai de regroupement des messages consécutifs d'un client (ms, WA-03).
WA_AI_DEBOUNCE_MS=7000
# Fournisseur de transcription des vocaux (vide = aucun : les vocaux sont
# transmis à un conseiller). À choisir après banc d'essai sur de la darija réelle.
TRANSCRIPTION_PROVIDER=
# Périmètre d'agences d'un worker ("12,15"), vide = toutes. Réservé aux
# scripts de recette (worker pointé sur de faux serveurs).
WA_WORKER_AGENCY_IDS=

# --- Lot 3 : exploitation (CLAUDE.md §3centtroisquadragies) ---
# Double authentification obligatoire pour ces rôles (séparés par des virgules).
ADMIN_2FA_ROLES=direction
# E-mails (rapport quotidien, alertes). Sans SMTP_HOST, rien n'est envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Alertes techniques au super admin (panne worker/Redis/webhook, sauvegarde).
ALERT_EMAILS=
# Sauvegardes chiffrées (openssl rand -base64 32) — À CONSERVER HORS DU SERVEUR.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30
# Copie hors du serveur via rclone (ex. b2:gf-backups) ; vide = pas de copie.
BACKUP_RCLONE_REMOTE=
